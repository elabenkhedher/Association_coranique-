{
  "info": {
    "name": "Association Coranique - API Tests",
    "description": "Collection Postman complète pour tester le backend Django de l'Association Coranique Omar Ibn Al-Khattab",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "admin_token", "value": "" },
    { "key": "enseignant_token", "value": "" },
    { "key": "centre_id", "value": "" },
    { "key": "enseignant_id", "value": "" },
    { "key": "apprenant_id", "value": "" },
    { "key": "creneau_id", "value": "" },
    { "key": "conversation_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login Admin → récupère token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.collectionVariables.set('admin_token', json.access);",
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Token présent', () => pm.expect(json.access).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin@association.tn\", \"password\": \"admin1234\"}"
        },
        "url": "{{base_url}}/api/token/"
      }
    },
    {
      "name": "2. GET /api/centres/ avec token admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Réponse est une liste', () => pm.expect(pm.response.json()).to.be.an('object'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
        "url": "{{base_url}}/api/centres/"
      }
    },
    {
      "name": "3. POST /api/centres/ → crée 'Centre Kelibia'",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.collectionVariables.set('centre_id', json.id);",
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Nom correct', () => pm.expect(json.nom).to.eql('Centre Kelibia'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{admin_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"nom\": \"Centre Kelibia\", \"adresse\": \"Rue Principale\", \"ville\": \"Kelibia\", \"telephone\": \"+216 72 111 000\"}"
        },
        "url": "{{base_url}}/api/centres/"
      }
    },
    {
      "name": "4. GET /api/centres/ → vérifie que le centre apparaît",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "var results = pm.response.json().results || pm.response.json();",
              "var found = results.some(c => c.nom === 'Centre Kelibia');",
              "pm.test('Centre Kelibia présent', () => pm.expect(found).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
        "url": "{{base_url}}/api/centres/"
      }
    },
    {
      "name": "5. POST /api/users/ → crée un enseignant",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.collectionVariables.set('enseignant_id', json.id);",
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Rôle enseignant', () => pm.expect(json.role).to.eql('enseignant'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{admin_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"test.enseignant@kelibia.tn\", \"nom\": \"Hamdi\", \"prenom\": \"Karim\", \"role\": \"enseignant\", \"centre\": {{centre_id}}, \"password\": \"enseignant123\"}"
        },
        "url": "{{base_url}}/api/users/"
      }
    },
    {
      "name": "6. POST /api/users/ → crée un apprenant",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.collectionVariables.set('apprenant_id', json.id);",
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Rôle apprenant', () => pm.expect(json.role).to.eql('apprenant'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{admin_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"test.apprenant@kelibia.tn\", \"nom\": \"Said\", \"prenom\": \"Omar\", \"role\": \"apprenant\", \"centre\": {{centre_id}}, \"password\": \"apprenant123\"}"
        },
        "url": "{{base_url}}/api/users/"
      }
    },
    {
      "name": "7. Login enseignant → récupère token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.collectionVariables.set('enseignant_token', json.access);",
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"enseignant1@association.tn\", \"password\": \"enseignant1234\"}"
        },
        "url": "{{base_url}}/api/token/"
      }
    },
    {
      "name": "8. POST /api/planning/ → crée un créneau",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.collectionVariables.set('creneau_id', json.id);",
              "pm.test('Status 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{admin_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"titre\": \"Cours Hifdh Lundi\", \"centre\": 1, \"enseignant\": 2, \"date\": \"2025-06-02\", \"heure_debut\": \"09:00:00\", \"heure_fin\": \"10:30:00\", \"est_annule\": false}"
        },
        "url": "{{base_url}}/api/planning/"
      }
    },
    {
      "name": "9. POST /api/planning/ → conflit horaire → doit retourner 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 400 (conflit détecté)', () => pm.response.to.have.status(400));",
              "var json = pm.response.json();",
              "pm.test('Message conflit présent', () => pm.expect(JSON.stringify(json)).to.include('conflit'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{admin_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"titre\": \"Cours conflit\", \"centre\": 1, \"enseignant\": 2, \"date\": \"2025-06-02\", \"heure_debut\": \"09:30:00\", \"heure_fin\": \"11:00:00\", \"est_annule\": false}"
        },
        "url": "{{base_url}}/api/planning/"
      }
    },
    {
      "name": "10. POST /api/presences/ → enregistre présence",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "var json = pm.response.json();",
              "pm.test('Statut présent', () => pm.expect(json.statut).to.eql('present'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{enseignant_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"creneau\": {{creneau_id}}, \"apprenant\": 4, \"statut\": \"present\"}"
        },
        "url": "{{base_url}}/api/presences/"
      }
    },
    {
      "name": "11. POST /api/lectures/ → enregistre séance de lecture",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "var json = pm.response.json();",
              "pm.test('Évaluation correcte', () => pm.expect(json.evaluation).to.eql(4));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{enseignant_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"enseignant\": 2, \"apprenant\": 4, \"date_seance\": \"2025-06-02\", \"sourate\": \"Al-Kahf\", \"verset_debut\": 1, \"verset_fin\": 10, \"type_lecture\": \"hifdh\", \"evaluation\": 4, \"commentaire\": \"Bonne mémorisation\", \"duree_minutes\": 40}"
        },
        "url": "{{base_url}}/api/lectures/"
      }
    },
    {
      "name": "12. GET /api/statistiques/apprenant/{id}/ → vérifie progression",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "var json = pm.response.json();",
              "pm.test('Champ apprenant présent', () => pm.expect(json).to.have.property('apprenant'));",
              "pm.test('Champ taux_presence présent', () => pm.expect(json).to.have.property('taux_presence'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
        "url": "{{base_url}}/api/statistiques/apprenant/4/"
      }
    },
    {
      "name": "13. POST /api/messagerie/conversations/ → crée conversation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.collectionVariables.set('conversation_id', json.id);",
              "pm.test('Status 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{enseignant_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"participants\": [2, 4]}"
        },
        "url": "{{base_url}}/api/messagerie/conversations/"
      }
    },
    {
      "name": "14. POST messages → envoie un message",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "var json = pm.response.json();",
              "pm.test('Contenu correct', () => pm.expect(json.contenu).to.include('Bonjour'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{enseignant_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"contenu\": \"Bonjour, avez-vous révisé la leçon d'aujourd'hui ?\"}"
        },
        "url": "{{base_url}}/api/messagerie/conversations/{{conversation_id}}/messages/"
      }
    },
    {
      "name": "15. GET /api/statistiques/export-excel/ → télécharge Excel",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type Excel', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('spreadsheetml'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
        "url": "{{base_url}}/api/statistiques/export-excel/"
      }
    }
  ]
}
